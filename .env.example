# Server-only. The browser never sees this value.
# Local stack: http://localhost:8012
# Public edge:   https://argus-api.xurl.fyi
AGENT_URL=http://localhost:8012

# Server-only Jaeger API base. Used by the operations console.
# Local stack: http://localhost:16686
# Public edge:   https://argus-api.xurl.fyi/jaeger
JAEGER_URL=http://localhost:16686

# Optional. Must match PUBLIC_BFF_TOKEN on the public proxy.
ARGUS_BFF_TOKEN=

# Required for the operations console. Both values must be set.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Canonical public URL used by metadata, robots, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
